# ─── Supabase ────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── App Identity ────────────────────────────────────────────
EXPO_PUBLIC_APP_NAME=Stalkr
EXPO_PUBLIC_BUNDLE_ID=com.stalkr.app
EXPO_PUBLIC_ANDROID_PACKAGE=com.stalkr.app

# ─── Google Maps (required for Android, optional iOS) ────────
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=your-android-maps-key
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=your-ios-maps-key

# ─── EAS ─────────────────────────────────────────────────────
EAS_PROJECT_ID=your-eas-project-id
EXPO_OWNER=your-expo-username

# ─── Crash Reporting — Sentry ────────────────────────────────
# Get DSN from: Sentry Dashboard → Project → Settings → Client Keys
EXPO_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ─── Analytics — PostHog ─────────────────────────────────────
# Get key from: PostHog → Project Settings → Project API Key
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_api_key
# Optional: override if self-hosting (default: https://us.i.posthog.com)
# EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-instance.com

# ─── Environment ─────────────────────────────────────────────
# Values: development | preview | production
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_key_here   # MUST start with appl_
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_key_here   # MUST start with goog_
